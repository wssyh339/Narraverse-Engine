{
  "$schema": "https://repomix.com/schemas/1.17.0/schema.json",
  "input": {
    "maxFileSize": 1048576,
    "processors": []
  },
  "output": {
    "filePath": ".ai-context/repomix.xml",
    "style": "xml",
    "filePathStyle": "target-relative",
    "parsableStyle": true,
    "compress": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "topFilesLength": 10,
    "tokenCountTree": true,
    "showLineNumbers": true,
    "truncateBase64": true,
    "copyToClipboard": false,
    "includeEmptyDirectories": false,
    "includeFullDirectoryStructure": false,
    "git": {
      "sortByChanges": false,
      "sortByChangesMaxCommits": 100,
      "includeDiffs": false,
      "includeLogs": false,
      "includeLogsCount": 50
    }
  },
  "include": [],
  "ignore": {
    "useGitignore": false,
    "useDotIgnore": false,
    "useDefaultPatterns": false,
    "customPatterns": [
      ".git/**",
      ".codebase-memory/**",
      ".ai-context/**",
      ".codex-tools/**",
      ".pnpm-store/**",
      ".playwright-cli/**",
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx",
      "**/credentials*.json",
      "**/secrets.*",
      "data/**",
      "backend/data/**",
      "backend/artifacts/**",
      "backend/backend/**",
      "backups/**",
      "exports/**",
      "output/**",
      "outputs/**",
      "logs/**",
      ".logs/**",
      "test-artifacts/**",
      "**/*.db",
      "**/*.db-*",
      "**/*.sqlite",
      "**/*.sqlite3",
      "**/*.sqlite-shm",
      "**/*.sqlite-wal",
      "**/*.backup",
      "**/*.bak",
      "**/*.epub",
      "**/*.docx",
      "**/*.pdf",
      "**/*.zip",
      "**/*.tar",
      "**/*.tgz",
      "**/*.tar.gz",
      "**/*.7z",
      "frontend/node_modules/**",
      "frontend/dist/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/*.pyc",
      "**/*.pyo",
      "**/.coverage",
      "coverage/**",
      "htmlcov/**",
      "docs/archive/**",
      "docs/superpowers/**",
      "docs/test-reports/**",
      "docs/**/*report*.md",
      "docs/**/*报告*.md"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
