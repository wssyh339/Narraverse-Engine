APP_ENV=development
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api

DATABASE_URL=sqlite:///./data/novel_agent.db
SQL_ECHO=false

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=novel_memory_v1

LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

LLM_TEMPERATURE=0.75
LLM_MAX_TOKENS=8192
EMBEDDING_MODEL=text-embedding-v4

CONTEXT_MAX_TOKENS=12000
CONTEXT_REQUIRED_RESERVE_TOKENS=7000
MEMORY_TOP_K=8
MEMORY_LEXICAL_FALLBACK=true
PROMPT_REGISTRY_VERSION=v1

JOB_ARTIFACT_DIR=artifacts/runs
JOB_POLL_INTERVAL_SECONDS=2
JOB_MAX_RETRY=1
JOB_CANCEL_CHECK_INTERVAL_SECONDS=1
REQUEST_TIMEOUT_SECONDS=120
