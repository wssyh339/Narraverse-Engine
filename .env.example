APP_ENV=development
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173

# Docker build configuration. Defaults use official Docker Hub images.
# If Docker Hub times out in mainland China, set these in .env:
# DOCKER_NODE_IMAGE=docker.1ms.run/library/node:24-alpine
# DOCKER_PYTHON_IMAGE=docker.1ms.run/library/python:3.13-slim
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
DOCKER_NODE_IMAGE=node:24-alpine
DOCKER_PYTHON_IMAGE=python:3.13-slim
NPM_REGISTRY=https://registry.npmjs.org/
PIP_INDEX_URL=

DATABASE_URL=sqlite:///./data/novel_agent.db
SQL_ECHO=false

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=novel_memory_v1

LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_REQUIRE_REMOTE=false

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-32B

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2-0711-preview

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-plus

OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.75
LLM_MAX_TOKENS=8192
EMBEDDING_MODEL=text-embedding-v4

CONTEXT_MAX_TOKENS=12000
CONTEXT_REQUIRED_RESERVE_TOKENS=7000
MEMORY_TOP_K=8
MEMORY_LEXICAL_FALLBACK=true
PROMPT_REGISTRY_VERSION=v1

DEEP_AGENT_ENABLED=false
DEEP_AGENT_MODE=advisor
DEEP_AGENT_ALLOW_WRITE=false

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=novel-agent-local
LANGSMITH_ENDPOINT=
LANGSMITH_PRIVACY_MODE=metadata_only
LANGSMITH_PROMPT_SYNC=manual

JOB_ARTIFACT_DIR=artifacts/runs
JOB_POLL_INTERVAL_SECONDS=2
JOB_MAX_RETRY=1
JOB_CANCEL_CHECK_INTERVAL_SECONDS=1
REQUEST_TIMEOUT_SECONDS=120
